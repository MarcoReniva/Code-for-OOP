            public static void createAccount()
            {
                bool again = false;
                while (!again)
                {
                    Console.Write("Enter new username: ");
                    string newusern = Console.ReadLine();
                    Console.Write("Enter new password: ");
                    string newpass = Console.ReadLine();
                    Console.WriteLine();
                    Console.Write("Confirm Password: ");
                    string confpass = Console.ReadLine();

                    if (string.IsNullOrEmpty(newusern) || string.IsNullOrEmpty(newpass) || string.IsNullOrEmpty(confpass))
                    {
                        Console.WriteLine("Username or Password cannot be empty.");
                        again = false;
                        return;
                    }
                    if (confpass != newpass)
                    {
                        WarningPopup("SECURITY ALERT", "Passwords do not match! Please try again.");
                        continue;
                    }

                    // --- 3. VALIDATION: USER EXISTS ---
