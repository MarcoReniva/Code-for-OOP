            static string CreateId(string countFile, string letter)
            {
                int number = 0;

                if (File.Exists(countFile))
                {
                    string text = File.ReadAllText(countFile);

                    if (text != "")
                    {
                        number = Convert.ToInt32(text);
                    }
                }
                number = number + 1;
                File.WriteAllText(countFile, number + "");

                string zeros = "";

                if (number < 10)
                    zeros = "000";
                else if (number < 100)
                    zeros = "00";
                else if (number < 1000)
                    zeros = "0";

                return letter + zeros + number;
            }
            public static void createAccount()
            {
                bool again = false;
                while (!again)
                {
                    Console.WriteLine("Choose a role");
                    Console.WriteLine("[1] Admin");
                    Console.WriteLine("[2] Employee");
                    Console.WriteLine("[3] Customer");
                    Console.Write("Enter your choice: ");
                    string roleChoice = Console.ReadLine();
                    string usern = "";
                    string datafile = "";
                    if(roleChoice == "1")
                    {
                        usern = CreateId("AdminCount.txt", "A");
                        datafile = "Admin.txt";
                        again = true;
                    }
                    else if (roleChoice == "2")
                    {
                        usern = CreateId("EmployeeCount.txt", "E");
                        datafile = "Employee.txt";
                        again = true;
                    }
                    else if (roleChoice == "3")
                    {
                        usern = CreateId("CustomerCount.txt", "C");
                        datafile = "Customer.txt";
                        again = true;
                    }
                    else
                    {
                        Console.WriteLine("Invalid choice. Please try again.");
                        again = false;
                        continue;
                    }
                    Console.Write("Enter new password: ");
                    string newpass = Console.ReadLine();
                    Console.WriteLine();
                    Console.Write("Confirm Password: ");
                    string confpass = Console.ReadLine();

                    if ( string.IsNullOrEmpty(newpass) || string.IsNullOrEmpty(confpass))
                    {
                        Console.WriteLine("Username or Password cannot be empty.");
                        again = false;
                        return;
                    }
                    if (confpass != newpass)
                    {
                        Console.WriteLine("SECURITY ALERT: Passwords do not match! Please try again.");
                        continue;
                    }
                    else
                    {
                        File.AppendAllText(datafile, usern + "," + newpass + Environment.NewLine);
                        //File.AppendAllLines(datafile, new string[] { usern + "," + newpass });
                        Console.WriteLine("Account created successfully! Your username is: " + usern);
                    }
                    

                }
            }
        }
